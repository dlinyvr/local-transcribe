# Settings for /transcribe. The first run fills this in with you; you can also edit it by hand.

# Where transcripts are saved (one folder per YouTube channel inside it).
TRANSCRIPTS_DIR=~/transcripts/youtube

# Whisper model for videos with no captions and for local files: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=medium

# Language of the videos (two-letter code). Leave empty to let Whisper guess.
LANGUAGE=en

# OPTIONAL, paid. Apify token, only used when YouTube blocks the free route and you say yes.
# Get it at https://console.apify.com/settings/integrations  (about 0.005 USD per video)
APIFY_TOKEN=
